# Settings for one RHOSO environment, read by apply.sh, cert-prereqs.sh and
# kickstart.py. Copy this file to rhoso/env/<name>.env (git ignores every
# .env here except this one) and use <name> as the ENV argument.
#
# Format: NAME=value, one per line; quotes around a value are dropped and
# nothing is expanded. Comments go on their own lines.
#
# The network values are RHOSO's documented example layout (install_yamls).
# Addresses from 192.0.2.0/24 are documentation placeholders: replace them.

# -- OpenShift ---------------------------------------------------------------

# Storage class for the control plane's volumes.
STORAGE_CLASS=local-storage
# The OpenShift node that carries the RHOSO networks (06-nncp.yaml is
# written for one node, as on OpenShift Local), its NIC for them, and that
# NIC's MAC, which the ospbr bridge takes.
OCP_NODE_NAME=crc
OCP_NODE_NIC=eth0
OCP_NODE_NIC_MAC=52:54:00:00:00:01

# -- RHOSO networks ----------------------------------------------------------
# Per network: its CIDR and prefix length, VLAN (except ctlplane, which is
# untagged), the OpenShift node's address on it, the range whereabouts gives
# pods, MetalLB's VIP range, and the ranges RHOSO assigns data plane nodes
# from (a YAML list).

CTLPLANE_CIDR=192.168.122.0/24
CTLPLANE_PREFIX=24
CTLPLANE_GATEWAY=192.168.122.1
CTLPLANE_NODE_IP=192.168.122.10
CTLPLANE_POD_RANGE_START=192.168.122.30
CTLPLANE_POD_RANGE_END=192.168.122.70
CTLPLANE_VIP_RANGE=192.168.122.80-192.168.122.90
CTLPLANE_EDPM_RANGES=[{start: 192.168.122.100, end: 192.168.122.120}, {start: 192.168.122.150, end: 192.168.122.200}]

INTERNALAPI_CIDR=172.17.0.0/24
INTERNALAPI_PREFIX=24
INTERNALAPI_VLAN=20
INTERNALAPI_NODE_IP=172.17.0.5
INTERNALAPI_POD_RANGE_START=172.17.0.30
INTERNALAPI_POD_RANGE_END=172.17.0.70
INTERNALAPI_VIP_RANGE=172.17.0.80-172.17.0.90
INTERNALAPI_EDPM_RANGES=[{start: 172.17.0.100, end: 172.17.0.250}]

STORAGE_CIDR=172.18.0.0/24
STORAGE_PREFIX=24
STORAGE_VLAN=21
STORAGE_NODE_IP=172.18.0.5
STORAGE_POD_RANGE_START=172.18.0.30
STORAGE_POD_RANGE_END=172.18.0.70
STORAGE_VIP_RANGE=172.18.0.80-172.18.0.90
STORAGE_EDPM_RANGES=[{start: 172.18.0.100, end: 172.18.0.250}]

TENANT_CIDR=172.19.0.0/24
TENANT_PREFIX=24
TENANT_VLAN=22
TENANT_NODE_IP=172.19.0.5
TENANT_POD_RANGE_START=172.19.0.30
TENANT_POD_RANGE_END=172.19.0.70
TENANT_VIP_RANGE=172.19.0.80-172.19.0.90
TENANT_EDPM_RANGES=[{start: 172.19.0.100, end: 172.19.0.250}]

# Fixed VIPs, from the ranges above: RHOSO's DNS on ctlplane, and on
# internalapi the internal API endpoints and the two RabbitMQ clusters.
DNS_VIP=192.168.122.80
INTERNALAPI_VIP=172.17.0.80
RABBITMQ_VIP=172.17.0.85
RABBITMQ_CELL1_VIP=172.17.0.86
# Upstream DNS servers for RHOSO's DNS; also the compute node's during its
# install.
DNS_SERVER_1=192.0.2.53
DNS_SERVER_2=192.0.2.54

# External network for floating IPs (cert-prereqs.sh creates it): a flat
# network on the datacentre physnet, sharing the ctlplane subnet in the lab.
# The pool must not overlap any range above.
EXTERNAL_PHYSNET=datacentre
EXTERNAL_CIDR=192.168.122.0/24
EXTERNAL_GATEWAY=192.168.122.1
EXTERNAL_POOL_START=192.168.122.210
EXTERNAL_POOL_END=192.168.122.250

# -- Data plane --------------------------------------------------------------

# The compute node: its name, its ctlplane address (inside
# CTLPLANE_EDPM_RANGES), and its NIC.
COMPUTE_NAME=edpm-compute-0
COMPUTE_CTLPLANE_IP=192.168.122.100
COMPUTE_NIC=eth0
# RHEL release the compute node stays on (RHOSO 18: 9.4 or 9.6).
RHEL_RELEASE=9.6
NTP_SERVER=pool.ntp.org
# True with a single compute node, so the resize tests can resize onto it.
NOVA_ALLOW_RESIZE_TO_SAME_HOST=True

# -- TrueNAS -----------------------------------------------------------------
# The same names tools/smoke_test.py and DevStack use. The API key never goes
# here: make-secrets.sh reads TRUENAS_API_KEY from the shell.

TRUENAS_IP=192.0.2.10
TRUENAS_POOL=tank
TRUENAS_PORTAL_ID=1
# false only for a self-signed certificate.
TRUENAS_VERIFY_SSL=true
# The dataset each Cinder backend keeps its volumes under (truenas, truenas2).
TRUENAS_DATASET_ROOT=rhoso
TRUENAS_DATASET_ROOT_2=rhoso2
# The NFS share Cinder backs up to; it must allow the nodes' address.
TRUENAS_BACKUP_PATH=/mnt/tank/rhoso-backup

# -- cinder-volume image -----------------------------------------------------

# Tag of the certified image imported as cinder-volume-truenas:<tag>.
CINDER_VOLUME_IMAGE_TAG=0.1.0-1
